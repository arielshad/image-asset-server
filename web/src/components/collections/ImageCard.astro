---
// One saved search result on a collection or source page: the thumbnail (from
// the source, at the image's own shape), badges for size and orientation, and
// the licence verdict. Icons and transparent images sit on a checkerboard. The
// card opens the image in the search app (full view, sizes, credit line); the
// footer links to its source page.
import { providerName, type SnapshotImage } from "@/lib/collections";
import { VERDICT_LABELS, categoryLabel, orientationLabel, resolutionBadge, verdictTone, type Verdict } from "@/lib/vocab";

interface Props {
  image: SnapshotImage;
  /** Load eagerly (the first row is above the fold). */
  eager?: boolean;
}
const { image: a, eager = false } = Astro.props;
const source = providerName(a.provider);
const verdict = (a.license?.verdict ?? "check-terms") as Verdict;
const tone = verdictTone(verdict);
const toneClass = { green: "border-success/40 text-success", amber: "border-warning/40 text-warning", red: "border-destructive/40 text-destructive" }[tone];
const icon = a.styles?.includes("icon");
const clear = a.transparent || a.vector;
const res = a.vector ? "SVG" : resolutionBadge(a.width, a.height);
const ratio = icon ? 1 : a.width && a.height ? Math.min(2.4, Math.max(0.5, a.width / a.height)) : 4 / 3;
const thumb = a.thumbnailUrl ?? a.previewUrl;
const meta = [source, a.year ? String(a.year) : "", categoryLabel(a.category)].filter(Boolean).join(" · ");
---
<li class="group mb-4 flex break-inside-avoid flex-col overflow-hidden rounded-xl border bg-card/50 transition hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5">
  <a href={`/search?image=${encodeURIComponent(a.id)}`} class="flex flex-1 flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" aria-label={`${a.title}, ${meta}. See it full size and get the files`}>
    <div class:list={["relative w-full overflow-hidden", clear ? "checker" : "bg-muted"]} style={`aspect-ratio: ${ratio}`}>
      {thumb ? (
        <img
          src={thumb}
          alt={`“${a.title}” on ${source}`}
          width={a.width && a.height && !icon ? 400 : 240}
          height={a.width && a.height && !icon ? Math.round(400 / ratio) : 240}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          referrerpolicy="no-referrer"
          class:list={["absolute inset-0 size-full transition duration-500 group-hover:scale-[1.03]", icon ? "object-contain p-[18%] dark:invert" : clear ? "object-contain" : "object-cover"]}
        />
      ) : (
        <span class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 bg-[radial-gradient(120%_120%_at_0%_0%,color-mix(in_oklch,var(--color-primary)_22%,transparent),transparent_60%),radial-gradient(120%_120%_at_100%_100%,color-mix(in_oklch,var(--color-brand-2)_18%,transparent),transparent_60%)] text-muted-foreground">
          <svg class="size-7 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>
          <span class="text-[11px]">Open to see it</span>
        </span>
      )}
      {(res || a.orientation) && !icon && (
        <span class="pointer-events-none absolute left-2 top-2 z-10 rounded-md bg-black/65 px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-white backdrop-blur-sm">
          {[res, a.orientation && a.orientation !== "landscape" ? orientationLabel(a.orientation) : ""].filter(Boolean).join(" · ")}
        </span>
      )}
    </div>
    <div class="flex flex-1 flex-col gap-2 p-3">
      <h3 class="line-clamp-2 text-sm font-medium leading-snug group-hover:text-primary">{a.title}</h3>
      <p class="truncate text-xs text-muted-foreground">{meta}{a.author && <> · {a.author}</>}</p>
      <div class="mt-auto flex flex-wrap gap-1 pt-1">
        <span class:list={["inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium", toneClass]} title={a.license ? `${a.license.name}: ${VERDICT_LABELS[verdict]}` : "No licence stated"}>{VERDICT_LABELS[verdict]}</span>
        {a.license?.editorial && <span class="inline-flex items-center rounded-full border border-warning/40 px-2 py-0.5 text-[10px] font-medium text-warning" title="People, insignia or brands without releases: not for ads">Editorial</span>}
        {a.license && <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium">{a.license.name}</span>}
      </div>
    </div>
  </a>
  <a href={a.url} rel="noopener" class="border-t px-3 py-2 text-xs text-muted-foreground transition hover:text-foreground">
    View on {source} <span aria-hidden="true">↗</span>
  </a>
</li>
